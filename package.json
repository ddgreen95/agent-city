{
  "name": "agent-city-hybrid-ai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5190 --strictPort",
    "build": "tsc --noEmit && vite build && node -e \"require('fs').rmSync('dist/feed',{recursive:true,force:true})\"",
    "preview": "vite preview --port 5191 --strictPort",
    "build:city": "vite build --mode city && node -e \"require('fs').rmSync('dist-city/feed',{recursive:true,force:true})\"",
    "build:graph": "vite build --mode graph && node -e \"require('fs').rmSync('dist-graph/feed',{recursive:true,force:true})\"",
    "build:all": "npm run build && npm run build:city && npm run build:graph"
  },
  "dependencies": {
    "@react-three/drei": "9.114.0",
    "@react-three/fiber": "8.17.10",
    "firebase": "13.3.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.169.0"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.169.0",
    "@vitejs/plugin-react": "4.3.3",
    "typescript": "5.6.3",
    "vite": "5.4.10"
  }
}
